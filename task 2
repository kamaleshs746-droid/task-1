from collections import deque
import heapq

# Directed graph
GRAPH = {
    "A": ["B", "C"],
    "B": ["D", "E"],
    "C": ["F", "G"],
    "D": ["H"],
    "E": ["H"],
    "F": ["I"],
    "G": ["J"],
    "H": ["K"],
    "I": ["K"],
    "J": ["K"],
    "K": ["L"],
    "L": []
}

# Travel costs
COSTS = {
    ("A", "B"): 1,
    ("A", "C"): 2,
    ("B", "D"): 1,
    ("B", "E"): 2,
    ("C", "F"): 3,
    ("C", "G"): 4,
    ("D", "H"): 2,
    ("E", "H"): 1,
    ("F", "I"): 2,
    ("G", "J"): 2,
    ("H", "K"): 1,
    ("I", "K"): 3,
    ("J", "K"): 2,
    ("K", "L"): 1
}


# --------------------------------------------------
# BFS - Breadth First Search
# --------------------------------------------------
def bfs(start, goal):
    queue = deque([(start, [start])])
    visited = {start}

    while queue:
        current, path = queue.popleft()

        if current == goal:
            return path

        for neighbor in GRAPH[current]:
            if neighbor not in visited:
                visited.add(neighbor)
                queue.append((neighbor, path + [neighbor]))

    return None


# --------------------------------------------------
# UCS - Uniform Cost Search
# --------------------------------------------------
def ucs(start, goal):
    priority_queue = [(0, start, [start])]
    visited = {}

    while priority_queue:
        cost, current, path = heapq.heappop(priority_queue)

        if current in visited and visited[current] <= cost:
            continue

        visited[current] = cost

        if current == goal:
            return path, cost

        for neighbor in GRAPH[current]:
            edge_cost = COSTS[(current, neighbor)]
            new_cost = cost + edge_cost

            heapq.heappush(
                priority_queue,
                (new_cost, neighbor, path + [neighbor])
            )

    return None, float("inf")


# --------------------------------------------------
# IDS - Iterative Deepening Search
# --------------------------------------------------
def depth_limited_search(current, goal, depth, path):
    if current == goal:
        return path

    if depth == 0:
        return None

    for neighbor in GRAPH[current]:
        if neighbor not in path:
            result = depth_limited_search(
                neighbor,
                goal,
                depth - 1,
                path + [neighbor]
            )

            if result is not None:
                return result

    return None


def ids(start, goal):
    depth = 0

    while True:
        result = depth_limited_search(
            start,
            goal,
            depth,
            [start]
        )

        if result is not None:
            return result

        depth += 1


# --------------------------------------------------
# Main Program
# --------------------------------------------------
if __name__ == "__main__":

    start = "A"
    goal = "L"

    # BFS
    bfs_path = bfs(start, goal)

    # UCS
    ucs_path, minimum_cost = ucs(start, goal)

    # IDS
    ids_path = ids(start, goal)

    print("Emergency Rescue Route Planner")
    print("--------------------------------")

    print("BFS Path:", bfs_path)
    print("UCS Path:", ucs_path)
    print("Minimum Cost:", minimum_cost)
    print("IDS Path:", ids_path)
